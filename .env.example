# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID(s) — comma-separated for multiple destinations
# Examples:
#   Single:   TELEGRAM_CHAT_ID=-1003752855916
#   Multiple: TELEGRAM_CHAT_ID=-1003752855916,123456789
# To find your chat ID: message @userinfobot or @RawDataBot
TELEGRAM_CHAT_ID=

# Polling interval in seconds (default: 300 = 5 min)
# POLL_INTERVAL=300

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO
